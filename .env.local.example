# ─────────────────────────────────────────────────────────────
# VindiBCN · Variables de entorno
# Copia este archivo a `.env.local` y rellena los valores reales.
# `.env.local` está en .gitignore y NUNCA debe subirse al repo.
# ─────────────────────────────────────────────────────────────

# URL del proyecto Supabase (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Clave pública "anon" (Project Settings → API → Project API keys → anon public)
# Segura para el navegador: la protege Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Clave "service_role" (Project Settings → API → Project API keys → service_role)
# ⚠️ SECRETA. Salta toda la RLS. Úsala SOLO en el servidor.
# Nunca la expongas en el cliente ni con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Clave de Resend para el envío de correos. Si falta, no se envía nada.
RESEND_API_KEY=your-resend-key

# Remitente de los correos, tal cual lo espera Resend. Si NO la defines, se usa
# el dominio de pruebas de Resend (onboarding@resend.dev) y los correos salen
# con ese remitente: defínela también en local para que coincida con producción.
NOTIFICATIONS_FROM_EMAIL=VindiBCN <hola@vindibcn.com>

# (Opcional) Correo general del centro para los avisos internos.
CENTER_EMAIL=hola@vindibcn.com
